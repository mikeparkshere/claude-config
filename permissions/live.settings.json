{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "ask": [
      "Bash(wp db import *)",
      "Bash(wp db clean *)",
      "Bash(wp db query *)",
      "Bash(wp search-replace *)",
      "Bash(wp site *)",
      "Bash(wp plugin *)",
      "Bash(wp theme *)",
      "Bash(wp core *)",
      "Bash(wp user *)",
      "Bash(wp option update *)",
      "Bash(wp option delete *)",
      "Bash(wp post delete *)",
      "Bash(wp rewrite *)",
      "Bash(wp cron event delete *)",
      "Bash(mysql *)",
      "Bash(crontab *)",
      "Bash(systemctl *)",
      "Bash(certbot *)",
