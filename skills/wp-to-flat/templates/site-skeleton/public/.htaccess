# Hybrid webapp (nginx → Apache): this file applies to requests nginx hands to Apache, i.e. pages and missing files.
# Static files nginx serves itself (css, js, images, fonts, .txt) never pass through here.
ErrorDocument 404 /404.php

# Staging stays out of search: noindex on every host except production. Lives in the repo because production never
# matches it, so there's nothing to remove at launch. Replace example.com with the production apex.
Header always set X-Robots-Tag "noindex, nofollow" "expr=%{HTTP_HOST} != 'example.com' && %{HTTP_HOST} != 'www.example.com'"

# Trailing slash on directory routes, always https. Apache sits behind nginx and never sees TLS, so mod_dir's own
# redirect (and any relative redirect) would say http://. Every redirect target hard-codes https://%{HTTP_HOST}.
DirectorySlash Off
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(example\.com)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

# Old WordPress URLs: paste url-map.js output (reduced/redirects.htaccess) here.
# BEGIN wp-to-flat redirects
# END wp-to-flat redirects

# Headers (pages only). nginx already sends nosniff and X-Frame-Options on RunCloud. HSTS on production only.
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTP_HOST} == 'example.com'"
# CSP: 'self' plus GA4 and Turnstile. Ship as Content-Security-Policy-Report-Only first, check every page type in a
# browser, then enforce. Each new third-party host needs an entry here or it fails silently.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://*.googletagmanager.com https://challenges.cloudflare.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
